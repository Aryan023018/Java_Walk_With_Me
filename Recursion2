package recursion;

public class Recursion2 {
	public static void printNumb(int n) {
		
		// base condition: stop recursion when n becomes 6
		if(n == 6) {      
			return;
		}
		System.out.println(n);
		printNumb(n + 1);
	}

	public static void main(String[] args) {
		//initialize
		int n = 1;
		printNumb(n);

	}

}
